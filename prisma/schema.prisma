generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ═══════════════════════════════════════════════════════════════════
// Models
// ═══════════════════════════════════════════════════════════════════

model Organization {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id             Int            @id @default(autoincrement())
  uuid           String         @unique @default(cuid())
  email          String         @unique
  password       String?
  name           String
  avatar         String?
  phone          String?
  bio            String?
  role           String         @default("agent") // admin, supervisor, agent, viewer
  status         String         @default("online") // online, offline, busy, away
  isActive       Boolean        @default(true) // For locking/blocking user
  settings       String         @default("{}") // JSON: user preferences (sound, notifications, language, etc.)
  organizationId Int?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  assignedConvos Conversation[]  @relation("Owner")
  followedConvos Conversation[]  @relation("Follower")
  notes          InternalNote[]
  notifications   Notification[]
  ownedLeads     Lead[]          @relation("LeadOwner")
  autoAssignRules AutomationRule[] @relation("AutoAssign")
  sessions       UserSession[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Customer {
  id        Int               @id @default(autoincrement())
  uuid      String            @unique @default(cuid())
  name      String
  phone     String?
  email     String?
  avatar    String?
  gender    String?
  birthday  String?
  company   String?
  address   String?
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  identities  CustomerIdentity[]
  conversations Conversation[]
  leads         Lead[]
  notes         InternalNote[]
}

model CustomerIdentity {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(cuid())
  customerId        Int
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform          String   // facebook, zalo, telegram, chatwork, website, email
  platformUserId    String?  // facebook_psid, zalo_user_id, telegram_chat_id, etc.
  platformPageId    String?  // facebook_page, oa_id, etc.
  platformUserName  String?
  platformAvatar    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([platform, platformUserId])
}

model Conversation {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(cuid())
  customerId  Int
  customer    Customer      @relation(fields: [customerId], references: [id])
  channel     String        // website, facebook_messenger, facebook_comment, zalo, telegram, chatwork, email
  status      String        @default("open") // open, pending, resolved, closed, spam, archived
  priority    String        @default("medium") // low, medium, high, urgent
  subject     String?
  slaFirstResponse DateTime?
  slaResolve      DateTime?
  ownerId    Int?
  owner      User?        @relation("Owner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  messages    Message[]
  tags       ConversationTag[]
  followers  User[]       @relation("Follower")
  notes      InternalNote[]
  leads      Lead[]

  @@index([channel])
  @@index([status])
  @@index([ownerId])
  @@index([customerId])
  @@index([createdAt])
}

model Message {
  id                Int           @id @default(autoincrement())
  uuid              String        @unique @default(cuid())
  conversationId    Int
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType        String        // customer, agent, bot, system
  senderId          Int?          // user id for agent messages
  senderName        String?
  messageType       String        @default("text") // text, image, video, audio, file, sticker, location, system, event
  content           String?
  attachmentUrl     String?
  attachmentName    String?
  attachmentType    String?
  platformMessageId String?
  isRead            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@index([platformMessageId])
}

model Tag {
  id          Int             @id @default(autoincrement())
  uuid        String          @unique @default(cuid())
  name        String          @unique
  color       String          @default("#6b7280")
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  conversations ConversationTag[]
  autoTagRules  AutomationRule[]  @relation("AutoTag")
}

model ConversationTag {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(cuid())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          Int
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, tagId])
}

model InternalNote {
  id             Int           @id @default(autoincrement())
  uuid           String        @unique @default(cuid())
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorId       Int
  author         User          @relation(fields: [authorId], references: [id])
  content        String
  isPinned       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Lead {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(cuid())
  customerId      Int?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId  Int?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  source          String?       // facebook_ads, google_ads, website, referral, organic
  campaign        String?
  status          String        @default("new") // new, contacted, qualified, proposal, negotiation, won, lost
  value           Float?
  ownerId         Int?
  owner           User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  nextFollowup    DateTime?
  probability     Int?          // 0-100
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AutomationRule {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(cuid())
  name        String
  keyword     String
  replyMessage String?
  assignToId  Int?
  assignTo    User?   @relation("AutoAssign", fields: [assignToId], references: [id], onDelete: SetNull)
  tagId       Int?
  tag         Tag?    @relation("AutoTag", fields: [tagId], references: [id], onDelete: SetNull)
  enabled     Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(cuid())
  userId        Int?
  action        String   // assign, transfer, reply, delete, merge, tag, status_change, login
  entityType    String?  // conversation, customer, message, tag, lead
  entityId      Int?
  details       String?  // JSON string
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ChannelConfig {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(cuid())
  channel    String   @unique // website, facebook_messenger, facebook_comment, zalo, telegram, chatwork, email
  enabled    Boolean  @default(false)
  config     String   @default("{}") // JSON: credentials & settings
  lastTestAt DateTime?
  lastTestOk Boolean?
  lastTestMsg String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(cuid())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   // new_message, assignment, sla_breach, mention, system, automation
  title          String
  body           String
  conversationId Int?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, read, createdAt])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Session token / JWT ID
  ipAddress String?
  userAgent String?
  device    String?  // Desktop, Mobile, Browser info
  lastActive DateTime @default(now())
  createdAt DateTime @default(now())
}
