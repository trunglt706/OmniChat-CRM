  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "fb_app_secret", "value": "test_app_secret_123" },
    { "key": "zalo_app_secret", "value": "test_zalo_secret_456" },
    { "key": "telegram_secret", "value": "test_telegram_secret_789" },
    { "key": "chatwork_token", "value": "test_chatwork_token_abc" },
    { "key": "webhook_secret", "value": "test_webhook_secret_xyz" }
  ],
