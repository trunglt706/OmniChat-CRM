      "item": [
        {
          "name": "Text Message",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Hub-Signature-256", "value": "sha256=PLACEHOLDER"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"page\",\n  \"entry\": [\n    {\n      \"id\": \"987654321098765\",\n      \"time\": 1722672000000,\n      \"messaging\": [\n        {\n          \"sender\": {\n            \"id\": \"112233445566778\"\n          },\n          \"recipient\": {\n            \"id\": \"987654321098765\"\n          },\n          \"timestamp\": 1722672000000,\n          \"message\": {\n            \"mid\": \"m_001_abc123def456\",\n            \"text\": \"Xin chao, toi can ho tro ve don hang DH2024001\"\n          }\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/webhook/facebook_messenger",
              "host": ["{{base_url}}"],
              "path": ["api", "webhook", "facebook_messenger"]
            }
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const crypto = require('crypto');",
                "const secret = pm.variables.get('fb_app_secret');",
                "const body = pm.request.body.raw;",
                "const sig = 'sha256=' + crypto.createHmac('sha256', secret).update(body).digest('hex');",
                "pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: sig });"
              ]
            }
          }]
        },
