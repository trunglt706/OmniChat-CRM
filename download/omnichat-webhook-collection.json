    {
      "name": "6. Website Widget",
      "item": [
        {
          "name": "Visitor Text Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"web_msg_001\",\n  \"visitorId\": \"vis_abc123def456\",\n  \"visitorName\": \"Khach vang\",\n  \"content\": \"Xin chao, toi can ho tro ve don hang\",\n  \"type\": \"text\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/webhook/website",
              "host": ["{{base_url}}"],
              "path": ["api", "webhook", "website"]
            }
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const crypto = require('crypto');",
                "const secret = pm.variables.get('webhook_secret');",
                "const body = pm.request.body.raw;",
                "const timestamp = Math.floor(Date.now() / 1000);",
                "const signedPayload = timestamp + '.' + body;",
                "const sig = crypto.createHmac('sha256', secret).update(signedPayload).digest('hex');",
                "pm.request.headers.upsert({ key: 'X-Webhook-Timestamp', value: String(timestamp) });",
                "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: sig });"
              ]
            }
          }]
        },
        {
          "name": "Visitor File Upload",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"web_msg_002\",\n  \"visitorId\": \"vis_xyz789uvw012\",\n  \"visitorName\": \"Nguyen Van C\",\n  \"content\": \"\",\n  \"type\": \"file\",\n  \"attachmentUrl\": \"https://example.com/invoice.pdf\",\n  \"attachmentName\": \"hoadon.pdf\",\n  \"attachmentType\": \"application/pdf\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/webhook/website",
              "host": ["{{base_url}}"],
              "path": ["api", "webhook", "website"]
            }
          },
          "event": [{
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const crypto = require('crypto');",
                "const secret = pm.variables.get('webhook_secret');",
                "const body = pm.request.body.raw;",
                "const timestamp = Math.floor(Date.now() / 1000);",
                "const signedPayload = timestamp + '.' + body;",
                "const sig = crypto.createHmac('sha256', secret).update(signedPayload).digest('hex');",
                "pm.request.headers.upsert({ key: 'X-Webhook-Timestamp', value: String(timestamp) });",
                "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: sig });"
              ]
            }
          }]
        }
      ]
